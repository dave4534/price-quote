{
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{node_modules/@sparticuz/chromium/bin/**,node_modules/@fontsource/assistant/files/assistant-{hebrew,latin}-{400,600,700}-normal.woff2}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__path=$1"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "regions": [
    "fra1"
  ]
}
